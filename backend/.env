# Backend environment configuration
# Your local network IP address (find using 'ipconfig' on Windows or 'ifconfig' on Linux/Mac)
# Leave as 'localhost' for local-only development, or set to your network IP (e.g., 192.168.0.203)
HOST_IP=192.168.0.203

# Application ports (used for CORS configuration)
BACKEND_PORT=5223
FRONTEND_PORT=3000
