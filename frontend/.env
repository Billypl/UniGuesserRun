# IMPORTANT: Keep this synchronized with ../\.env (root directory)
# When you change HOST_IP in the root .env, update VITE_HOST_IP here too
# Or better: Delete this file and the root .env values will be used in Docker

# Your local network IP - MUST MATCH HOST_IP in root .env
VITE_HOST_IP=https://192.168.0.10
VITE_API_TARGET=https://192.168.0.10:5223
VITE_BACKEND_PORT=5223
