# Shared environment configuration for both frontend and backend
# Your local network IP address (find using 'ipconfig' on Windows or 'ifconfig' on Linux/Mac)
# Leave as 'localhost' for local-only development, or set to your network IP (e.g., 192.168.0.10)
HOST_IP=192.168.0.10

# Ports
BACKEND_PORT=5223
FRONTEND_PORT=3000

# Database configuration (for Docker)
DB_PORT=5432
DB_PASSWORD=1234
DB_USER=postgres
DB_NAME=UniGuesser
DB_ADMIN_PANEL_PORT=8080
